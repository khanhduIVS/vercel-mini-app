# Neon / Postgres connection string.
# On Vercel: auto-injected when you add a Neon integration from the Vercel Marketplace.
# For local dev: copy from Vercel Dashboard > Storage > your-db > .env.local
DATABASE_URL=
# Legacy fallback (Vercel Postgres migrated to Neon):
POSTGRES_URL=

# Unsplash API Key (optional — for image search feature)
# Get one at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
